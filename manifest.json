{
  "manifest_version": 3,
  "name": "Minimal Text-to-Speech",
  "version": "1.1",
  "description": "Select text on any page to listen to it with minimal playback controls.",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "css": ["styles.css"],
      "js": ["content.js"]
    }
  ]
}